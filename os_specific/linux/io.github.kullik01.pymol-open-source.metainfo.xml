<?xml version="1.0" encoding="UTF-8"?>
<!-- AppStream metadata: description and screenshot in software centers such as GNOME Software
     and KDE Discover. build_packages.sh fills in @VERSION@ and @DATE@. -->
<component type="desktop-application">
  <id>io.github.kullik01.pymol-open-source</id>
  <metadata_license>CC0-1.0</metadata_license>
  <!-- This project's code, the bundled Qt/PySide6 and PyMOL; the texts are in the app's licenses folder -->
  <project_license>BSD-3-Clause AND LGPL-3.0-only AND HPND</project_license>
  <name>PyMOL-Open-Source</name>
  <summary>Visualize and animate 3D molecular structures</summary>
  <developer id="io.github.kullik01">
    <name>Hannah Kullik, Martin Urban</name>
  </developer>
  <description>
    <p>
      PyMOL is a Python-enhanced molecular graphics tool. It excels at 3D visualization of
      proteins, small molecules, density, surfaces and trajectories. It also includes molecular
      editing, ray tracing and movies.
    </p>
    <p>
      This is an unofficial, ready-to-run build of the open-source PyMOL. It can download
      structures directly from the Protein Data Bank (PDB).
    </p>
  </description>
  <launchable type="desktop-id">pymol-open-source.desktop</launchable>
  <provides>
    <binary>PyMOL-Open-Source</binary>
    <mediatype>chemical/x-pdb</mediatype>
    <mediatype>chemical/x-cif</mediatype>
    <mediatype>application/x-pymol-session</mediatype>
  </provides>
  <categories>
    <category>Education</category>
    <category>Chemistry</category>
  </categories>
  <url type="homepage">https://kullik01.github.io/pymol-open-source-setup/</url>
  <url type="bugtracker">https://github.com/kullik01/pymol-open-source-setup/issues</url>
  <url type="vcs-browser">https://github.com/kullik01/pymol-open-source-setup</url>
  <screenshots>
    <screenshot type="default">
      <caption>A protein structure in the PyMOL main window</caption>
      <image>https://kullik01.github.io/pymol-open-source-setup/assets/images/image_1.png</image>
    </screenshot>
  </screenshots>
  <content_rating type="oars-1.1"/>
  <releases>
    <release version="@VERSION@" date="@DATE@"/>
  </releases>
</component>
