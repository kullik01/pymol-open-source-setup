<?xml version="1.0" encoding="UTF-8"?>
<!-- File types that the shared MIME database does not know yet (it knows chemical/x-pdb).
     Installed as /usr/share/mime/packages/pymol-open-source.xml. -->
<mime-info xmlns="http://www.freedesktop.org/standards/shared-mime-info">
  <mime-type type="chemical/x-cif">
    <comment>Crystallographic Information File</comment>
    <sub-class-of type="text/plain"/>
    <glob pattern="*.cif"/>
  </mime-type>
  <mime-type type="application/x-pymol-session">
    <comment>PyMOL session</comment>
    <glob pattern="*.pse"/>
  </mime-type>
</mime-info>
