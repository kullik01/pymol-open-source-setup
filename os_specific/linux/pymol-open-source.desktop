[Desktop Entry]
Name=PyMOL-Open-Source
Comment=Powerful visualization software for rendering and animating 3D molecular structures.
GenericName=Molecular Viewer
Exec=/opt/pymol-open-source/PyMOL-Open-Source %F
Icon=pymol-open-source
Type=Application
StartupNotify=false
StartupWMClass=PyMOL
Categories=Education;Chemistry;
Keywords=pymol;
MimeType=chemical/x-pdb;chemical/x-cif;application/x-pymol-session;
