<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDevelopmentRegion</key>
	<string>English</string>
	<key>CFBundleExecutable</key>
	<string>PyMOL-Open-Source</string>
	<key>CFBundleIdentifier</key>
	<string>io.github.kullik01.pymol-open-source</string>
	<key>CFBundleIconFile</key>
	<string>icon.icns</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>PyMOL-Open-Source</string>
	<key>CFBundleDisplayName</key>
	<string>PyMOL-Open-Source</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<!-- Files that open with PyMOL in Finder (.pdb, .cif and PyMOL sessions) -->
	<key>CFBundleDocumentTypes</key>
	<array>
		<dict>
			<key>CFBundleTypeName</key>
			<string>Molecular structure</string>
			<key>CFBundleTypeRole</key>
			<string>Viewer</string>
			<key>LSHandlerRank</key>
			<string>Alternate</string>
			<key>LSItemContentTypes</key>
			<array>
				<string>io.github.kullik01.pymol-open-source.pdb</string>
				<string>io.github.kullik01.pymol-open-source.cif</string>
			</array>
		</dict>
		<dict>
			<key>CFBundleTypeName</key>
			<string>PyMOL session</string>
			<key>CFBundleTypeRole</key>
			<string>Editor</string>
			<key>LSHandlerRank</key>
			<string>Owner</string>
			<key>LSItemContentTypes</key>
			<array>
				<string>io.github.kullik01.pymol-open-source.pse</string>
			</array>
		</dict>
	</array>
	<key>UTImportedTypeDeclarations</key>
	<array>
		<dict>
			<key>UTTypeIdentifier</key>
			<string>io.github.kullik01.pymol-open-source.pdb</string>
			<key>UTTypeDescription</key>
			<string>Protein Data Bank file</string>
			<key>UTTypeConformsTo</key>
			<array>
				<string>public.plain-text</string>
			</array>
			<key>UTTypeTagSpecification</key>
			<dict>
				<key>public.filename-extension</key>
				<array>
					<string>pdb</string>
				</array>
			</dict>
		</dict>
		<dict>
			<key>UTTypeIdentifier</key>
			<string>io.github.kullik01.pymol-open-source.cif</string>
			<key>UTTypeDescription</key>
			<string>Crystallographic Information File</string>
			<key>UTTypeConformsTo</key>
			<array>
				<string>public.plain-text</string>
			</array>
			<key>UTTypeTagSpecification</key>
			<dict>
				<key>public.filename-extension</key>
				<array>
					<string>cif</string>
				</array>
			</dict>
		</dict>
	</array>
	<!-- PyMOL's own session format, which this app owns -->
	<key>UTExportedTypeDeclarations</key>
	<array>
		<dict>
			<key>UTTypeIdentifier</key>
			<string>io.github.kullik01.pymol-open-source.pse</string>
			<key>UTTypeDescription</key>
			<string>PyMOL session</string>
			<key>UTTypeConformsTo</key>
			<array>
				<string>public.data</string>
			</array>
			<key>UTTypeTagSpecification</key>
			<dict>
				<key>public.filename-extension</key>
				<array>
					<string>pse</string>
				</array>
			</dict>
		</dict>
	</array>
	<key>LSMinimumSystemVersion</key>
	<string>12.0</string>
	<key>NSHighResolutionCapable</key>
	<string>True</string>
	<key>NSPrincipalClass</key>
	<string>NSApplication</string>
</dict>
</plist>
